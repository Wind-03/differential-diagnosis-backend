# Neon PostgreSQL
# Paste the pooled Neon connection string from your Neon project.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# DeepSeek (required only for the conversational agent)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Comma-separated frontend origins. Use * only for local development.
CORS_ORIGINS=http://localhost:5173

# Differential diagnosis threshold; preserved from the original implementation.
DIAGNOSIS_THRESHOLD=0.6
